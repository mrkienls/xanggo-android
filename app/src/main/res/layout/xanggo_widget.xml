<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: XăngGo + Thời gian cập nhật -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⛽ Giá Xăng 24h"
            android:textColor="#14B8A6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vùng 1"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Hàng giá xăng: RON 95-III & E5 RON 92 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Cột 1: RON 95-III -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_ron95_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RON 95-III"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_ron95_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21.060 đ"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_ron95_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲ +1.210đ"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cột 2: E5 RON 92 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_e5_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E5 RON 92"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_e5_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19.860 đ"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_e5_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲ +860đ"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
